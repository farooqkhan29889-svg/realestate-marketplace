# =====================================================================
# REAL ESTATE MARKETPLACE - PRODUCTION CONFIGURATION
# =====================================================================

# 1. Database Connection (PostgreSQL)
# Option A: Full Connection String (recommended for Render, Railway, Neon, Supabase, AWS RDS)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/realestate_db

# Option B: Individual Credentials (used if DATABASE_URL is not provided)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=realestate_db

# 2. Security & JWT
# "development" seeds demo data + enables quick-login. Use "production" when live.
ENVIRONMENT=production
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_secure_random_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated allowed browser origins (use your real domain in production,
# e.g. CORS_ORIGINS=https://yourdomain.com). "*" is for local dev only.
CORS_ORIGINS=*

# Admin bootstrap account created on first run. CHANGE THESE before deploying.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# Upload limits
MAX_UPLOAD_SIZE_MB=5
MAX_UPLOAD_FILES=10

# Simple in-memory rate limits (requests per window, per IP)
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_SECONDS=60

# 3. Platform 1% Commission Policy
COMMISSION_PERCENT_SELLER=1.0
COMMISSION_PERCENT_BUYER=1.0

# 4. Server Port (used when running via uvicorn in cloud environments)
PORT=8000
